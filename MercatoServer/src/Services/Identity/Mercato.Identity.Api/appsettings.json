{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "mercato-identity",
    "Audience": "mercato",
    "AccessTokenLifetimeMinutes": 10
  },
  "Auth": {
    "RefreshCookiePath": "/api/identity"
  },
  "Seed": {
    "AdminEmail": "admin@mercato.local",
    "AdminUsername": "admin",
    "AdminName": "Store Admin"
  }
}
