## =========================================================================
## Secrets & environment — NEVER commit real credentials (applies repo-wide,
## both MercatoServer/ and MercatoClient/)
## =========================================================================
.env
.env.*
!.env.example

*.pem
*.key
*.pfx
*.p12
*.crt
id_rsa
id_rsa.pub
service-account*.json
*.credentials.json
.aws/
.azure/
.npmrc

# ASP.NET Core: appsettings*.json is committed by convention (no secrets should
# live in it — use `dotnet user-secrets` or environment variables instead).
# If a local override ever needs real secrets, name it appsettings.*.local.json
# and it will be ignored automatically.
appsettings.*.local.json
secrets.json

# NOTE (Vite/MercatoClient): any .env variable prefixed VITE_ gets inlined into
# the public JS bundle at build time. Never put real API keys/secrets behind a
# VITE_ prefix — gitignore-ing .env does not help once it's already built in.

## =========================================================================
## IDE / OS junk (repo-wide)
## =========================================================================
# Visual Studio
.vs/
*.vspscc
*.vssscc

# VS Code — keep shared settings, ignore personal/workspace clutter
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# OS
.DS_Store
Thumbs.db

# Office lock files (created while a .doc*/.xls*/.ppt* is open, never real content)
~$*

